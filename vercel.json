{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "server/**"
    },
    "api/**/*.ts": {
      "includeFiles": "server/**"
    },
    "api/index.ts": {
      "includeFiles": "server/**"
    }
  }
}
